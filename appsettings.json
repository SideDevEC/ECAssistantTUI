{
     "root_path": "ECAssistant",
      "memory": {
         "data_path": "Memory",
          "enabled": true,
           "load_on_start": true,
            "save_on_exit": true,
             "max_entries": 500,
              "auto_backup": true
       },

        "workspace": {
            "path": "Workspace",
             "allow_delete": true,
              "max_size_mb": 500,
               "auto_cleanup": true
         },

          "tools": {
              "e_power_shell_agent": {
                 "enabled": true,
                  "use_pwsh_core": true,
                   "fallback_to_powershell_exe": true,
                    "max_output_chars": 50000
             },
              "e_file_research_tool": {
                 "enabled": true,
                  "default_extensions": [".cs", ".md", ".json", ".txt", ".xml", ".ps1", ".sln", ".csproj", ".config", ".sql", ".html", ".css", ".js"],
                   "max_chars_per_file": 15000,
                    "max_files_to_scan": 50,
                     "query_limit": 20
              }
           },

            "llm": {
                "model_path": "Qwen3-8B-Q4_K_M.gguf",
                 "context_size": 8192,
                  "gpu_layers": 15,
                   "threads": -1,
                    "batch_size": 256,
                     "ubatch_size": 128
             },

              "secondary_model": {
                 "enabled": false,
                  "model_path": "",
                   "context_size": 4096,
                    "gpu_layers": 0
             },

              "vector_memory": {
                 "enabled": true,
                  "directory": "vecmem",
                   "max_results": 5,
                    "auto_index": true
             },

              "inference": {
                  "max_tokens": 2048,
                   "temperature": 0.3,
                    "top_p": 0.9,
                     "repeat_penalty": 1.1,
                       "anti_prompts": [
                           "User:",
                            "\n```\n",
                             "Question:",
                              "---",
                               "</toolcall>",
                               "</output>"
],
                         "tokens_keep": 0,
                          "overflow_strategy": "ThrowException",
                           "decode_special_tokens": false
                     },

                      "context_management": {
                         "strategy": "SummaryAndShift",
                          "shift_at_messages": 40,
                           "keep_last": 20,
                            "summarize_prompt": "Summarize the key decisions, actions taken, and current state of our conversation. Keep it concise but include any important findings or tool results that will help me continue this task.",
                             "max_summary_length": 2000,
                              "auto_shift_on_generate": true,
                               "shift_guardrail_threshold": 3
                         },

                          "sampling": {
                             "temperature": 0.3,
                              "top_p": 0.9,
                               "top_k": 40,
                                "repeat_penalty": 1.1,
                                 "penalty_last_n": 64,
                                  "mirostat": false,
                                   "mirostat_tau": 5.0,
                                    "mirostat_eta": 0.1
                             },

                              "agent": {
                                 "working_directory": ".",
                                  "allow_delete": true,
                                   "allowed_extensions": [".txt", ".json", ".md", ".cs", ".py", ".html", ".xml", ".ps1", ".sln", ".csproj"]
                             },

                              "interface": {
                                  "history_max_messages": 50,
                                   "show_elapsed_time": true,
                                    "prompt_prefix": "[You]: ",
                                     "response_prefix": "[Agent]: ",
                                      "auto_clear_history_after": null
                               }
                           }
