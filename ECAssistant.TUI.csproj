<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant.TUI</RootNamespace>
    <AssemblyName>ECAssistant.TUI</AssemblyName>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- NuGet package — ECAssistant.TUI is consumed by ECAssistantConsole via PackageReference. -->
    <IsPackable>true</IsPackable>
    <PackageId>ECAssistant.TUI</PackageId>
    <PackageVersion>12.9.0</PackageVersion>
    <Authors>SideDevEC</Authors>
    <Company>SideDevEC</Company>
    <Product>ECAssistant</Product>
    <PackageTags>ecassistant;tui;terminal;local-llm</PackageTags>
    <PackageProjectUrl>https://github.com/SideDevEC/ECAssistantTUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SideDevEC/ECAssistantTUI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>ECAssistant TUI — terminal UI library for the ECAssistant local AI agent.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.TUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core as NuGet package — no lib/ DLLs, no sync step. -->
    <PackageReference Include="ECAssistant.Core" Version="12.9.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Controller/AppController.cs" />
    <Compile Include="Controller/TuiSetupUi.cs" />
    <Compile Include="Input/AnsiInputParser.cs" />
    <Compile Include="Controller/IAppController.cs" />
    <Compile Include="UI/IGuiConsole.cs" />
    <Compile Include="UI/EGuiConsole.cs" />
    <Compile Include="UI/BaseLayer.cs" />
    <Compile Include="UI/StartupLayer.cs" />
    <Compile Include="UI/ConfigLayer.cs" />
    <Compile Include="UI/HelpLayer.cs" />
    <Compile Include="UI/SessionLayer.cs" />
    <Compile Include="UI/LoadingIndicator.cs" />
    <Compile Include="UI/ConsoleUiRenderer.cs" />
    <Compile Include="UI/ITerminalOutput.cs" />
    <Compile Include="UI/ConsoleTerminalOutput.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>