<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ECAssistant</RootNamespace>
    <AssemblyName>e-assistant</AssemblyName>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- App compiles Program.cs + concrete UI classes (EGuiConsole, layers, LoadingIndicator, ConsoleUiRenderer) -->
    <Compile Remove="**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="UI/EGuiConsole.cs" />
    <Compile Include="UI/HelpLayer.cs" />
    <Compile Include="UI/IGuiLayer.cs" />
    <Compile Include="UI/SessionLayer.cs" />
    <Compile Include="UI/LoadingIndicator.cs" />
    <Compile Include="UI/ConsoleUiRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ECAssistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>