<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ECAssistant</RootNamespace>
    <AssemblyName>e-assistant</AssemblyName>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is referenced as a compiled DLL from the ECAssistantCore project. -->
    <!-- Build ECAssistantCore first, then copy the DLL here. -->
    <Reference Include="ECAssistant.Core">
      <HintPath>..\ECAssistantCore\bin\Debug\net8.0\ECAssistant.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- App compiles only entry point + concrete UI implementations -->
    <Compile Remove="**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="UI/EGuiConsole.cs" />
    <Compile Include="UI/IGuiLayer.cs" />
    <Compile Include="UI/HelpLayer.cs" />
    <Compile Include="UI/SessionLayer.cs" />
    <Compile Include="UI/LoadingIndicator.cs" />
    <Compile Include="UI/ConsoleUiRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(OS)' == 'WINDOWS'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>