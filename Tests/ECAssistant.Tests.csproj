<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ECAssistant.Tests</RootNamespace>
    <!-- Global test timeout: 30 seconds per test. Prevents hung tests from eating CPU forever. -->
    <xUnitCoreSettings>methodTimeout=30000</xUnitCoreSettings>
    <xUnitReporterSettings>methodTimeout=30000</xUnitReporterSettings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECAssistant.csproj" />
    <Reference Include="ECAssistant.Core">
      <HintPath>..\..\ECAssistantCore\bin\Debug\net8.0\ECAssistant.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>