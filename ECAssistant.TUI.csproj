<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant.TUI</RootNamespace>
    <AssemblyName>ECAssistant.TUI</AssemblyName>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.TUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core.dll in lib/ (gitignored, built locally) -->
    <Reference Include="ECAssistant.Core">
      <HintPath>lib\ECAssistant.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Controller/AppController.cs" />
    <Compile Include="UI/IGuiConsole.cs" />
    <Compile Include="UI/EGuiConsole.cs" />
    <Compile Include="UI/BaseLayer.cs" />
    <Compile Include="UI/StartupLayer.cs" />
    <Compile Include="UI/ConfigLayer.cs" />
    <Compile Include="UI/HelpLayer.cs" />
    <Compile Include="UI/SessionLayer.cs" />
    <Compile Include="UI/LoadingIndicator.cs" />
    <Compile Include="UI/ConsoleUiRenderer.cs" />
    <Compile Include="UI/ITerminalOutput.cs" />
    <Compile Include="UI/ConsoleTerminalOutput.cs" />
  </ItemGroup>

</Project>