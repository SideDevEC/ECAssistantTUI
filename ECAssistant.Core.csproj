<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant</RootNamespace>
    <AssemblyName>ECAssistant.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>ECAssistant.Core</PackageId>
    <Description>ECAssistant Core — local AI agent engine, tools, session management, and memory system. Library for embedding ECAssistant into any .NET application.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="e-assistant" />
    <InternalsVisibleTo Include="ECAssistant.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core: compile everything EXCEPT Program.cs, Tests, and concrete UI implementations -->
    <!-- Core owns: EGuiBase (abstract), EColor, StringUtil, Orchestrator, Engine/, Session/, Services/, etc. -->
    <!-- App owns: Program.cs, EGuiConsole, IGuiLayer, HelpLayer, SessionLayer, LoadingIndicator, ConsoleUiRenderer -->
    <Compile Remove="Program.cs" />
    <Compile Remove="Tests/**" />
    <Compile Remove="UI/EGuiConsole.cs" />
    <Compile Remove="UI/IGuiLayer.cs" />
    <Compile Remove="UI/HelpLayer.cs" />
    <Compile Remove="UI/SessionLayer.cs" />
    <Compile Remove="UI/LoadingIndicator.cs" />
    <Compile Remove="UI/ConsoleUiRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(OS)' == 'WINDOWS'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SystemPrompt.md" Pack="true" PackagePath="content/" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SystemPrompt.Windows.md" Pack="true" PackagePath="content/" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SystemPrompt.Mac.md" Pack="true" PackagePath="content/" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" Pack="true" PackagePath="content/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>