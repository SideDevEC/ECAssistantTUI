<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ECAssistant</RootNamespace>
    <AssemblyName>e-assistant</AssemblyName>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- One DLL. Everything included. Nothing else needed. -->
    <Reference Include="ECAssistant.Core">
      <HintPath>lib\ECAssistant.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="UI/EGuiConsole.cs" />
    <Compile Include="UI/IGuiLayer.cs" />
    <Compile Include="UI/HelpLayer.cs" />
    <Compile Include="UI/SessionLayer.cs" />
    <Compile Include="UI/LoadingIndicator.cs" />
    <Compile Include="UI/ConsoleUiRenderer.cs" />
  </ItemGroup>

</Project>