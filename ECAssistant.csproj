<Project Sdk="Microsoft.NET.Sdk">
          <PropertyGroup>
              <!-- v10.16: Cross-platform — net8.0 instead of net8.0-windows -->
              <TargetFramework>net8.0</TargetFramework>
              <ImplicitUsings>enable</ImplicitUsings>
              <Nullable>enable</Nullable>
              <OutputType>Exe</OutputType>
              <RootNamespace>ECAssistant</RootNamespace>
              <AssemblyName>e-assistant</AssemblyName>
              <PublishAot>false</PublishAot>
              <SelfContained>false</SelfContained>
          </PropertyGroup>

          <ItemGroup>
              <PackageReference Include="LLamaSharp" Version="0.27.0" />
              <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
              <!-- v10.16: GPU backends are OS-specific — include both via conditionals -->
              <!-- Windows/Linux: CUDA 12 for NVIDIA GPU -->
              <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(OS)' == 'WINDOWS'" />
              <!-- macOS: Vulkan for Metal (MoltenVK) -->
              <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" Condition="'$(OS)' != 'WINDOWS'" />
              <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
          </ItemGroup>

          <ItemGroup>
              <Content Include="SystemPrompt.md">
                  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
              </Content>
              <Content Include="SystemPrompt.Windows.md">
                  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
              </Content>
              <Content Include="SystemPrompt.Mac.md">
                  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
              </Content>
              <Content Include="appsettings.json">
                  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
              </Content>
          </ItemGroup>
      </Project>