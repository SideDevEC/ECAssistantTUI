<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>ECAssistant</RootNamespace>
    <AssemblyName>e-assistant</AssemblyName>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <!-- MSB3277: System.Text.Json version unification — harmless. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core NuGet package — brings managed DLL + all dependencies automatically. -->
    <PackageReference Include="ECAssistant.Core" Version="1.0.0" />
    <!-- LLamaSharp.Backend.* — native runtime file providers only. -->
    <!-- These copy llama.dll / libllama.dylib to the output folder. -->
    <!-- No managed API — just native binaries. App never touches LLamaSharp types. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(OS)' == 'WINDOWS'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App compiles only entry point + concrete UI implementations -->
    <Compile Remove="**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="UI/EGuiConsole.cs" />
    <Compile Include="UI/IGuiLayer.cs" />
    <Compile Include="UI/HelpLayer.cs" />
    <Compile Include="UI/SessionLayer.cs" />
    <Compile Include="UI/LoadingIndicator.cs" />
    <Compile Include="UI/ConsoleUiRenderer.cs" />
  </ItemGroup>

</Project>